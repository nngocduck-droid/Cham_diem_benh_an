# ── Bắt buộc ──
GEMINI_API_KEY=

# Khoá ký phiên đăng nhập & link email. Tạo bằng:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Địa chỉ app, dùng trong link gửi qua email (không có dấu / ở cuối)
APP_BASE_URL=https://chamdiembenhan-production.up.railway.app

# ── Gửi email (chọn MỘT cách) ──
# Cách 1 – Brevo (khuyên dùng; chạy được trên Railway gói Free/Hobby)
BREVO_API_KEY=
MAIL_FROM=email-da-xac-minh-trong-brevo@gmail.com
MAIL_FROM_NAME=Chấm Bệnh Án AI

# Cách 2 – SMTP (vd. Gmail + App Password). Railway chỉ mở SMTP ở gói Pro.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ban@gmail.com
# SMTP_PASSWORD=app-password-16-ky-tu
# MAIL_FROM=ban@gmail.com

# Không đặt BREVO_API_KEY lẫn SMTP_HOST → chế độ thử: email chỉ in ra log (dùng khi chạy trên máy).

# ── Đăng ký tài khoản ──
# Mã phải nhập khi đăng ký. Bỏ trống dòng này → dùng APP_PASSWORD cũ làm mã.
# Đặt REGISTRATION_CODE=off để ai cũng đăng ký được (chỉ cần xác nhận email).
# REGISTRATION_CODE=
APP_PASSWORD=

# (Tuỳ chọn) chỉ cho đăng ký bằng email thuộc các tên miền này
# ALLOWED_EMAIL_DOMAINS=hmu.edu.vn,gmail.com

# Email admin gốc (cách nhau bởi dấu phẩy). Đăng ký bằng email này → có trang Quản trị.
# Lịch sử chấm cũ (trước khi có tài khoản) thuộc admin gốc đăng nhập đầu tiên.
ADMIN_EMAILS=

# (Tuỳ chọn) thư mục lưu CSDL. Trên Railway không cần đặt nếu đã gắn Volume.
# DATA_DIR=/data
